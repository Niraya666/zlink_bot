# 复制为 .env 后填入真实值：cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，不要提交，也不要粘贴进任何聊天窗口。
#    传到别的机器用 scp，不要走 IM。

# LLM —— 默认走 DeepSeek 的 Anthropic 兼容端点
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-chat

# 可选：不带命令行参数时默认跑哪个活动
# 优先级：命令行参数 > ACTIVITY > 唯一 pack
# ACTIVITY=zchat-23
